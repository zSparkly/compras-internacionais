{
  "info": {
    "name": "Compras Internacionais - Backend II",
    "description": "Segundo exercício. Inicie a API e o MySQL antes de executar. Cada registro válido consome o limite mensal do cliente; simular não grava. A cotação vem da AwesomeAPI real e pode variar. Cenários de falha externa e concorrência são reproduzidos pela suíte Java, com servidor HTTP controlado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "clienteId",
      "value": "11111111-1111-1111-1111-111111111111"
    }
  ],
  "item": [
    {
      "name": "01 - Simular US$ 200 (não grava)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/compras/simular",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"valorUSD\": 200.0\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Resposta JSON\", () => pm.response.to.be.json);",
              "pm.test(\"Total é soma das parcelas\", () => { const r = pm.response.json(); pm.expect(r.valorFinalBRL).to.be.closeTo(r.valorConvertido + r.taxaServico + r.tributoSimulado, 0.001); });",
              "pm.test(\"Taxa de 2%\", () => { const r = pm.response.json(); pm.expect(r.taxaServico).to.be.closeTo(Math.round(r.valorConvertido * 0.02 * 100) / 100, 0.001); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Simular US$ 99,99 (taxa de 5%)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/compras/simular",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"valorUSD\": 99.99\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Resposta JSON\", () => pm.response.to.be.json);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Registrar US$ 200 (grava e consome limite)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/compras",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clienteId\": \"{{clienteId}}\",\n  \"valorUSD\": 200.0\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Resposta JSON\", () => pm.response.to.be.json);",
              "pm.test(\"Compra com ID gerado\", () => pm.expect(pm.response.json().id).to.be.a(\"string\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Histórico preservado",
